AnnotationAssertion(<http://www.w3.org/2002/07/owl#versionInfo> <https://oced> "semlog <version>")
AnnotationAssertion(<https://oced#buildConfiguration> <https://oced> <settings>)
AnnotationAssertion(<https://oced#sourceLog> <https://oced> "golden")
AnnotationAssertion(rdfs:comment :Attribute "A named, typed value associated with an event or object.")
AnnotationAssertion(rdfs:comment :EndEvent_order "Events with no directly-follows successor in the 'order' case trace.")
AnnotationAssertion(rdfs:comment :Event "An atomic, timestamped occurrence of an activity in the process, such as creating an order or inserting a payment. Each event is of exactly one event type and may relate to any number of objects.")
AnnotationAssertion(rdfs:comment :EventAttribute "An attribute defined for an event type, carrying a single value fixed at the time of the event.")
AnnotationAssertion(rdfs:comment :Object "An entity that participates in the process, such as an order, invoice, or product. Each object is of exactly one object type and may carry attributes whose values can change over time.")
AnnotationAssertion(rdfs:comment :ObjectAttribute "An attribute defined for an object type. Its value is recorded with a timestamp and may change over the object's lifetime.")
AnnotationAssertion(rdfs:comment :StartEvent_order "Events with no directly-follows predecessor in the 'order' case trace.")
AnnotationAssertion(rdfs:comment :Time "A point in time, used as an event timestamp or to date an object attribute value.")
AnnotationAssertion(rdfs:comment :amount "Attribute 'amount' of a event.")
AnnotationAssertion(rdfs:comment :attribute_of "Inverse of has attribute: relates an attribute to its owning event or object.")
AnnotationAssertion(rdfs:comment :channel "Attribute 'channel' of a object.")
AnnotationAssertion(rdfs:comment :clerk "Attribute 'clerk' of a event.")
AnnotationAssertion(rdfs:comment :concerns "Relates 'event' to 'order' via the 'concerns' relationship.")
AnnotationAssertion(rdfs:comment :contains "Relates 'order' to 'item' via the 'contains' relationship.")
AnnotationAssertion(rdfs:comment :df "Holds between two events when one immediately precedes the other within any case. Supertype of all case-specific directly-follows properties.")
AnnotationAssertion(rdfs:comment :df_order "Holds between two events when one immediately precedes the other in the same 'order' case trace.")
AnnotationAssertion(rdfs:comment :due "Attribute 'due' of a event.")
AnnotationAssertion(rdfs:comment :event_object_relation "A qualified event-to-object relationship, associating an event with an object that takes part in it.")
AnnotationAssertion(rdfs:comment :handles "Relates 'event' to 'item' via the 'handles' relationship.")
AnnotationAssertion(rdfs:comment :has_amount "Links a event to its 'amount' attribute value.")
AnnotationAssertion(rdfs:comment :has_attribute "Relates an event or object to one of its attributes.")
AnnotationAssertion(rdfs:comment :has_channel "Links a object to its 'channel' attribute value.")
AnnotationAssertion(rdfs:comment :has_clerk "Links a event to its 'clerk' attribute value.")
AnnotationAssertion(rdfs:comment :has_data_value "Attaches a literal value to an attribute, attribute change, or time individual.")
AnnotationAssertion(rdfs:comment :has_due "Links a event to its 'due' attribute value.")
AnnotationAssertion(rdfs:comment :has_price "Links a object to its 'price' attribute value.")
AnnotationAssertion(rdfs:comment :inv_concerns "Inverse of 'concerns': relates 'order' back to 'event'.")
AnnotationAssertion(rdfs:comment :inv_contains "Inverse of 'contains': relates 'item' back to 'order'.")
AnnotationAssertion(rdfs:comment :inv_df "Relates an event to the event that directly precedes it within any case. Inverse of 'directly followed by'.")
AnnotationAssertion(rdfs:comment :inv_df_order "Relates an event to its direct predecessor in the same 'order' case trace. Inverse of 'directly followed (via order) by'.")
AnnotationAssertion(rdfs:comment :inv_event_object_relation "Inverse of involves object: relates an object to the events it participates in.")
AnnotationAssertion(rdfs:comment :inv_handles "Inverse of 'handles': relates 'item' back to 'event'.")
AnnotationAssertion(rdfs:comment :inv_has_amount "Links a 'amount' attribute value to its owning event.")
AnnotationAssertion(rdfs:comment :inv_has_channel "Links a 'channel' attribute value to its owning object.")
AnnotationAssertion(rdfs:comment :inv_has_clerk "Links a 'clerk' attribute value to its owning event.")
AnnotationAssertion(rdfs:comment :inv_has_due "Links a 'due' attribute value to its owning event.")
AnnotationAssertion(rdfs:comment :inv_has_price "Links a 'price' attribute value to its owning object.")
AnnotationAssertion(rdfs:comment :inv_object_object_relation "Inverse of is related to object: the symmetric counterpart of an object-to-object relationship.")
AnnotationAssertion(rdfs:comment :item "Objects of type 'item'.")
AnnotationAssertion(rdfs:comment :object_object_relation "A qualified object-to-object relationship, associating an object with another object independently of any event.")
AnnotationAssertion(rdfs:comment :observed_at "Relates an event to the time point of its timestamp.")
AnnotationAssertion(rdfs:comment :observes "Inverse of observed at: relates a time point to the events timestamped at it.")
AnnotationAssertion(rdfs:comment :order "Objects of type 'order'.")
AnnotationAssertion(rdfs:comment :place "Events of type 'place'.")
AnnotationAssertion(rdfs:comment :price "Attribute 'price' of a object.")
AnnotationAssertion(rdfs:comment :ship "Events of type 'ship'.")
